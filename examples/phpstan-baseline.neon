parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method Illuminate\\Contracts\\Cache\\Lock\:\:acquire\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: tests/CachingExamplesTest.php

		-
			message: '#^Called ''pluck'' on Laravel collection, but could have been retrieved as a query\.$#'
			identifier: larastan.noUnnecessaryCollectionCall
			count: 1
			path: tests/DatabasePerformanceExamplesTest.php

		-
			message: '#^Class Illuminate\\Database\\Eloquent\\LazyLoadingViolationException not found\.$#'
			identifier: class.notFound
			count: 1
			path: tests/EloquentExamplesTest.php

		-
			message: '#^Access to an undefined property MLE\\Examples\\Tests\\Fixtures\\Models\\Order\:\:\$customer_id\.$#'
